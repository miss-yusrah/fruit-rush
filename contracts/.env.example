# Required for deployment script
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Role addresses
ADMIN_ADDRESS=0xYOUR_MULTISIG_ADDRESS
MINTER_ADDRESS=0xYOUR_BACKEND_HOT_WALLET
ROYALTY_RECEIVER=0xYOUR_TREASURY_WALLET

# Base metadata URI (trailing slash required)
BASE_URI=https://meta.fruitrush.io/

# Celo RPC endpoints
CELO_RPC_URL=https://forno.celo.org

# Celoscan API key for contract verification
CELOSCAN_API_KEY=YOUR_CELOSCAN_API_KEY
